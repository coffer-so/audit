itialization-is-unauthenticated-front-run-window)1688 0 R(l-06--unchecked-decimal-normalization-overflow-in-the-invariant-calculation)1689 0 R(l-07--withdraw_sol-never-checks-that-source-belongs-to-the-config-it-authenticates-against)1690 0 R(l-08--single-token-liquiditys-sol-withdrawal-guard-can-never-be-satisfied)1691 0 R(l-09--protocol-admin-rotation-never-re-checks-that-the-new-admin-is-the-treasury-pda)1692 0 R(l-10--debug_withdraw_liquidity-performs-an-unchecked-cpi-with-a-caller-controlled-program-vault-and-recipient)1693 0 R(l-11--deflating-virtual-balance-at-a-window-rotation-locks-out-honest-sells)1694 0 R(l-12--no-working-operator-tool-for-the-migration-instruction)1695 0 R(l-13--single-token-deposits-revert-once-a-pools-balance-grows-past-a-fixed-point-ceiling)1696 0 R(low-severity)1683 0 R(m-01--overflow-checks-disabled-in-the-release-profile)1677 0 R(m-02--range-manager-envelope-caps-velocity-not-distance)1678 0 R(m-03--upgrade-authority-transfer-and-program-freeze-cannot-execute)1679 0 R(m-04--lopsided-deposits-decouple-visible-depth-from-priced-depth)1680 0 R(m-05--splitting-a-swap-avoids-the-surge-fee)1681 0 R(m-06--range_manager_updates-set-semantics-create-a-lost-update-race-with-concurrent-ops)1682 0 R(medium-severity)1676 0 R(privileged-roles)1661 0 R(s-01--just-in-time-liquidity-can-skim-swap-fees)1706 0 R(s-02--withdrawing-liquidity-amplifies-price-impact)1707 0 R(smart-contract-code-review-and-security-analysis-report-for-cube-dex)1653 0 R(table-of-contents)1654 0 R(threat-model)1663 0 R]>>>>>>
